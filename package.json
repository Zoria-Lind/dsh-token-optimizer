{
  "name": "dsh-token-optimizer",
  "version": "2.2.0",
  "description": "分层 Token 优化管道 v2:输出阶梯 / 结果缓存 / 文件 diff / 工具裁剪 + MCP 懒加载 / 压缩调度 / 缓存命中率,基于 DSH 真实插件 API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zoria-Lind/dsh-token-optimizer.git"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2 <0.1.2",
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "unknown",
        "0.1.3-alpha.1": "unknown"
      }
    },
    "pluginType": "feature"
  },
  "keywords": [
    "dsh",
    "token",
    "optimizer",
    "compression",
    "dsh-plugin",
    "deepseek-harness"
  ]
}
